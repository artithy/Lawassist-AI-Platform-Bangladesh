APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin(s) of the browser frontend allowed to call the API (CORS). Comma-separated, exact scheme://host[:port], no wildcard.
# REQUIRED in production: if it is not set there, no origin is allowed (the localhost default only applies when APP_ENV is local/testing).
FRONTEND_ORIGIN=http://localhost:5173

# API rate limits, requests per minute (optional). Defaults: 300 per client address and 120 per signed-in client in
# production; ten times that in local/testing. Missing, zero, negative or non-numeric values fall back to the default.
# API_RATE_LIMIT_PER_IP=300
# API_RATE_LIMIT_PER_TOKEN=120

# Ollama (language-model server), used by App\Services\AI\OllamaService.
# Laravel runs in Docker and Ollama on the Mac host, which containers reach as host.docker.internal.
# Without Docker use http://localhost:11434. Timeouts are in seconds; a missing, zero or non-numeric value uses the default.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_TIMEOUT=120

# Opt-in test that talks to the REAL Ollama (never part of the normal test run). Set to true only when you want it:
#   php artisan test tests/Integration/OllamaIntegrationTest.php
# RUN_OLLAMA_INTEGRATION_TESTS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Supabase Auth (JWT verification) -------------------------------------------------------------------
# Your project URL (same as the frontend's VITE_SUPABASE_URL), e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Must match the "aud" claim of signed-in users' tokens (Supabase default).
SUPABASE_JWT_AUDIENCE=authenticated
# Optional. Leave empty to use <SUPABASE_URL>/auth/v1/.well-known/jwks.json (must be https).
SUPABASE_JWKS_URL=
# Cache store (a name from config/cache.php) for Supabase's public signing keys. Keep it private to the server:
# "file" (default) or a private "redis". Avoid "database": that table is in the Supabase public schema.
SUPABASE_JWKS_CACHE_STORE=file

# TRANSITION ONLY - tokens signed before the switch to ES256 signing keys used the legacy HS256 shared secret.
# While this secret is set, those tokens are still accepted. Once they have expired, leave BOTH empty and delete
# the secret. NEVER commit a real value.
SUPABASE_LEGACY_JWT_SECRET=
# Optional ISO-8601 cut-off (e.g. 2026-11-02T12:00:00Z) after which HS256 is rejected even if the secret is set.
SUPABASE_LEGACY_HS256_UNTIL=
