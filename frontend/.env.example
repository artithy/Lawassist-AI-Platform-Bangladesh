# Example only. Your real settings stay in ".env" (never commit that file).
# Find the values in Supabase -> Project Settings -> API.
#
# Use ONLY the publishable (or older "anon") key here. Never put the service_role / secret key in a VITE_ variable:
# everything that starts with VITE_ is sent to every visitor's browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
